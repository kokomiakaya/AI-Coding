# ===== DeepSeek 对话模型（OpenAI 兼容模式）=====
# 模型名以 deepseek 开头时自动使用下方密钥与地址；改为 qwen-* 则切回百炼
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-chat

# ===== 嵌入 / 重排（默认本地化，免费离线）=====
# local = BGE 本地模型（fastembed/ONNX）；dashscope = 百炼 text-embedding-v4（需额度）
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
# local = 本地混合分数重排（向量相似度+BM25 加成）；dashscope = qwen3-rerank（需额度）
RERANK_PROVIDER=local
RERANK_MODEL=qwen3-rerank

# ===== 阿里云百炼（DashScope）备用配置（充值后可切回）=====
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank

# ===== 服务配置 =====
SECRET_KEY=请改成随机长字符串
JWT_EXPIRE_HOURS=24
DATABASE_URL=sqlite+aiosqlite:///./storage/ragkb.db
CHROMA_PERSIST_DIR=./storage/chroma
UPLOAD_DIR=./storage/uploads
LOG_DIR=./storage/logs

# ===== 离线演示模式（无网络/无 Key 时可用，LLM/嵌入/重排返回确定性假数据）=====
MOCK_MODE=0
# 测试环境置 1 可关闭接口限流（生产保持 0）
RATE_LIMIT_DISABLED=0
